---
import { EDITOR_PATH } from "../paths";

/** Where everything is: the product, the developer material, and the project. */
const groups = [
  {
    heading: "Product",
    links: [
      { label: "Editor", href: EDITOR_PATH },
      { label: "How profiles extend", href: "/docs/concepts/" },
    ],
  },
  {
    heading: "Developers",
    links: [
      { label: "Docs", href: "/docs/" },
      { label: "Adopt Omote", href: "/docs/guides/adopt/" },
      { label: "Lexicons", href: "/docs/reference/lexicons/" },
      { label: "npm packages", href: "https://www.npmjs.com/org/omote-social" },
      { label: "Specification", href: "https://github.com/Saeris/omote/blob/main/docs/spec.md" },
    ],
  },
  {
    heading: "Project",
    links: [
      { label: "GitHub", href: "https://github.com/Saeris/omote" },
      { label: "MIT license", href: "https://github.com/Saeris/omote/blob/main/LICENSE" },
    ],
  },
];
---

<footer class="border-t border-neutral-200 bg-white">
  <div class="mx-auto grid max-w-5xl gap-8 px-6 py-10 sm:grid-cols-3">
    {
      groups.map((group) => (
        <nav aria-label={group.heading} class="flex flex-col gap-2 text-sm">
          <h2 class="font-semibold">{group.heading}</h2>
          <ul class="flex flex-col gap-1.5 text-neutral-600">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-neutral-900 hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <p class="mx-auto max-w-5xl px-6 pb-8 text-xs text-neutral-500">
    Built on the <a href="https://atproto.com" class="underline">AT Protocol</a>. Omote stores
    nothing: your profiles live in your own account.
  </p>
</footer>
