---
import { EDITOR_PATH } from "../paths";

/**
 * The site's navigation, the same on every page: the homepage, the editor, and the docs, where Starlight renders it in place of its own header.
 *
 * Styled with scoped CSS rather than Tailwind, because Starlight's pages don't load the site's Tailwind stylesheet. The docs pass their search box in the `search` slot.
 */

const path = Astro.url.pathname;
const links = [
  { label: "Docs", href: "/docs/", current: path.startsWith("/docs/"), narrow: true },
  // Also in the footer and the docs' mobile menu, so it gives way on narrow screens.
  { label: "GitHub", href: "https://github.com/Saeris/omote", current: false, narrow: false },
];
---

<nav aria-label="Site" class="site-nav">
  <a href="/" class="wordmark">omote</a>
  <div class="search"><slot name="search" /></div>
  <ul class="links">
    {
      links.map((link) => (
        <li class:list={{ wide: !link.narrow }}>
          <a href={link.href} aria-current={link.current ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        href={EDITOR_PATH}
        class="editor"
        aria-current={path.startsWith(EDITOR_PATH) ? "page" : undefined}
      >
        Open the editor
      </a>
    </li>
  </ul>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
    font-family:
      ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: #171717;
  }

  .wordmark {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: inherit;
    text-decoration: none;
  }

  .search {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .site-nav,
    .links {
      gap: 1rem;
    }

    .wide {
      display: none;
    }
  }

  .links a:hover,
  .links a[aria-current="page"]:not(.editor) {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .links .editor {
    border-radius: 0.375rem;
    background: #171717;
    padding: 0.375rem 0.75rem;
    font-weight: 500;
    color: #fff;
  }

  .links .editor:hover {
    background: #404040;
    text-decoration: none;
  }
</style>
