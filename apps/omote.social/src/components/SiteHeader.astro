---
import { EDITOR_PATH } from "../paths";

/** The site's top bar: home, docs, source, and the editor. */
---

<header class="border-b border-neutral-200 bg-white">
  <nav
    aria-label="Site"
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-4"
  >
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      omote
    </a>
    <ul class="flex items-center gap-5 text-sm">
      <li><a href="/docs/" class="hover:underline">Docs</a></li>
      <li><a href="https://github.com/Saeris/omote" class="hover:underline">GitHub</a></li>
      <li>
        <a href={EDITOR_PATH} class="rounded-md bg-neutral-900 px-3 py-1.5 font-medium text-white">
          Open the editor
        </a>
      </li>
    </ul>
  </nav>
</header>
