---
import SiteNav from "./SiteNav.astro";

/** The top bar on the site's own pages. The docs put the same navigation in Starlight's header (see DocsHeader.astro). */
---

<header class="site-header">
  <SiteNav />
</header>

<style>
  /* The same height, border and padding as Starlight's header, so moving between the site and the docs changes nothing at the top. */
  .site-header {
    height: 3.5rem;
    padding-inline: 1.5rem;
    border-bottom: 1px solid #e5e5e5;
    background: #fff;
  }
</style>
