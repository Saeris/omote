---
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-50 text-neutral-900 antialiased">
    <div class="mx-auto flex max-w-5xl flex-col gap-10 px-6 py-12">
      <slot />
    </div>
  </body>
</html>
