{
  "lexicon": 1,
  "id": "social.omote.getProfile",
  "defs": {
    "main": {
      "type": "query",
      "description": "An account's profile as it appears in one context: that context's override merged over the base profile. A convenience for prototyping and for apps that would rather not resolve identities themselves; the `@omote/profiles` library does the same work from the records, with no service in between.",
      "parameters": {
        "type": "params",
        "required": ["actor", "context"],
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier"
          },
          "context": {
            "type": "string",
            "description": "The context's NSID authority, e.g. `social.taproom`.",
            "maxLength": 253
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "#profileView"
        }
      },
      "errors": [{ "name": "ActorNotFound" }, { "name": "InvalidContext" }]
    },
    "profileView": {
      "type": "object",
      "required": ["did", "handle", "context", "sources"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "context": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "pronouns": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "avatar": {
          "type": "string",
          "format": "uri",
          "description": "Served by the account's own PDS."
        },
        "banner": {
          "type": "string",
          "format": "uri",
          "description": "Served by the account's own PDS."
        },
        "sources": {
          "type": "ref",
          "ref": "#sources"
        }
      }
    },
    "sources": {
      "type": "object",
      "description": "Where each field came from: `override` (this context), `base` (the base profile) or `hidden` (in the base, hidden here). Fields absent from both are absent here.",
      "properties": {
        "displayName": { "type": "string", "knownValues": ["override", "base", "hidden"] },
        "description": { "type": "string", "knownValues": ["override", "base", "hidden"] },
        "pronouns": { "type": "string", "knownValues": ["override", "base", "hidden"] },
        "website": { "type": "string", "knownValues": ["override", "base", "hidden"] },
        "avatar": { "type": "string", "knownValues": ["override", "base", "hidden"] },
        "banner": { "type": "string", "knownValues": ["override", "base", "hidden"] }
      }
    }
  }
}
